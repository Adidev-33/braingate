# BrainGate Environment Configuration (Optional)

# Groq Cloud LLM API Key (Recommended for ultra-fast Llama 3.3 / GPT-OSS explanations)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model choice (Default: openai/gpt-oss-120b, or llama-3.3-70b-versatile, or llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-120b

# Other Optional LLM Providers (Fallbacks)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
